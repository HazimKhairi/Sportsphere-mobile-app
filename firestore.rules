rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Membership lives in club_users/{uid}_{clubId} — doc ID is uid + '_' + clubId.
    // Returns true if the document exists (any role = member of that club).
    function isClubMember(clubId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/club_users/$(request.auth.uid + '_' + clubId));
    }

    // Returns true if the user has a staff-level role in the given club.
    // One get() — safe fallback to '' when doc is missing.
    function isClubStaff(clubId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/club_users/$(request.auth.uid + '_' + clubId))
          .data.get('role', '')
          in ['STAFF', 'COACH', 'ADMIN', 'OWNER'];
    }

    // Global staff check for rules outside a /clubs/{clubId} match.
    // Reads users/{uid}.activeClubId then delegates to isClubStaff().
    // Cost: 2 external reads (users + club_users).
    function isStaff() {
      return isSignedIn() &&
        isClubStaff(
          get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.get('activeClubId', '')
        );
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isStaff();

      // Recovery logs — player owns, staff cannot see (personal wellness data).
      match /recovery_logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Club memberships (club_users collection) ─────────────────────────────
    // Backend-managed — mobile can only read its own membership doc.

    match /club_users/{membershipId} {
      allow read: if isSignedIn() &&
        membershipId.matches(request.auth.uid + '_.*');
      allow write: if false;
    }

    // ─── Players ─────────────────────────────────────────────────────────────

    match /players/{playerId} {
      allow read, update: if isOwner(playerId);
      allow read: if isStaff();

      match /body_composition/{entryId} {
        allow read, write: if isOwner(playerId);
        allow read: if isStaff();
      }

      match /unlocked_achievements/{aId} {
        allow read: if isOwner(playerId);
        allow read, write: if isStaff();
      }
    }

    // ─── Achievements catalog ─────────────────────────────────────────────────

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ─── Stripe / Payments ────────────────────────────────────────────────────

    match /stripe_payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.playerId == request.auth.uid ||
         resource.data.userId == request.auth.uid);
      allow read: if isStaff();
    }

    // ─── Clubs ───────────────────────────────────────────────────────────────
    // Use isClubMember/isClubStaff (clubId in scope) — avoids the extra
    // users-doc read that isStaff() requires.

    match /clubs/{clubId} {
      allow read: if isClubMember(clubId) || isClubStaff(clubId);
      allow write: if isClubStaff(clubId);

      match /rewards/{rewardId} {
        allow read: if isClubMember(clubId) || isClubStaff(clubId);
        allow write: if isClubStaff(clubId);
      }

      match /sessions/{sessionId} {
        allow read: if isClubMember(clubId) || isClubStaff(clubId);
        allow write: if isClubStaff(clubId);
      }

      match /members/{memberId} {
        allow read: if isClubMember(clubId) || isOwner(memberId) || isClubStaff(clubId);
        allow write: if isClubStaff(clubId);
      }

      match /workoutTemplates/{templateId} {
        allow read: if isClubMember(clubId) || isClubStaff(clubId);
        allow write: if isClubStaff(clubId);
      }

      match /training_plans/{planId} {
        allow read: if isClubMember(clubId) || isClubStaff(clubId);
        allow write: if isClubStaff(clubId);
      }
    }

    // ─── Drills ──────────────────────────────────────────────────────────────

    match /drills/{drillId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ─── Activity / Timeline ─────────────────────────────────────────────────

    match /activity/{userId}/{entryId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) || isStaff();
    }

    // ─── Recovery content (coach-curated) ────────────────────────────────────

    match /recovery_content/{contentId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
