rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Check role from users doc — accepts both mobile convention ('staff')
    // and backend club role values ('OWNER', 'ADMIN', 'COACH').
    function isStaff() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['staff', 'OWNER', 'ADMIN', 'COACH'];
    }

    function isMemberOfClub(clubId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isStaff();
    }

    // ─── Players ─────────────────────────────────────────────────────────────

    match /players/{playerId} {
      allow read, update: if isOwner(playerId);
      allow read: if isStaff();

      // Body composition — player owns, staff can view.
      match /body_composition/{entryId} {
        allow read, write: if isOwner(playerId);
        allow read: if isStaff();
      }

      // Achievements unlocked by this player.
      match /unlocked_achievements/{aId} {
        allow read: if isOwner(playerId);
        allow read, write: if isStaff();
      }
    }

    // ─── Achievements catalog ─────────────────────────────────────────────────

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ─── Stripe / Payments ────────────────────────────────────────────────────

    match /stripe_payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.playerId == request.auth.uid ||
         resource.data.userId == request.auth.uid);
      allow read: if isStaff();
    }

    // ─── Clubs ───────────────────────────────────────────────────────────────

    match /clubs/{clubId} {
      allow read: if isMemberOfClub(clubId);
      allow write: if isStaff();

      match /rewards/{rewardId} {
        allow read: if isMemberOfClub(clubId);
        allow write: if isStaff();
      }

      match /sessions/{sessionId} {
        allow read: if isMemberOfClub(clubId);
        allow write: if isStaff();
      }

      match /members/{memberId} {
        allow read: if isMemberOfClub(clubId) || isOwner(memberId);
        allow write: if isStaff();
      }

      match /workoutTemplates/{templateId} {
        allow read: if isMemberOfClub(clubId);
        allow write: if isStaff();
      }

      match /training_plans/{planId} {
        allow read: if isMemberOfClub(clubId);
        allow write: if isStaff();
      }
    }

    // ─── Drills ──────────────────────────────────────────────────────────────

    match /drills/{drillId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ─── Activity / Timeline ─────────────────────────────────────────────────

    match /activity/{userId}/{entryId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) || isStaff();
    }

    // ─── Recovery logs ────────────────────────────────────────────────────────

    match /users/{userId}/recovery_logs/{logId} {
      allow read, write: if isOwner(userId);
    }

    // ─── Recovery content (coach-curated) ────────────────────────────────────

    match /recovery_content/{contentId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
