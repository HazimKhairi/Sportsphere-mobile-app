platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Allow arm64 simulator builds — MLKit frameworks are patched below.
  # Set at both project and target level to override the xcconfig value.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
  end
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
    end
  end

  require 'fileutils'

  # Patch device-only arm64 frameworks for arm64 iOS Simulator compatibility.
  # Strategy:
  #   Mach-O binaries  → vtool (has space for load command rewrite)
  #   Static archives  → scan binary in-place for embedded Mach-O headers and
  #                      patch LC_BUILD_VERSION platform IOS(2)→IOSSIM(7)
  #                      without extract/repack (avoids broken symbol tables)
  patcher_path = '/tmp/patch_ios_to_sim.py'
  File.write(patcher_path, <<~'PYTHON')
    import struct, sys, os
    LC_BUILD_VERSION = 0x32
    PLATFORM_IOS     = 2
    PLATFORM_IOSSIM  = 7
    MACHO64_LE       = 0xFEEDFACF

    def patch_macho_at(data, base):
        if base + 32 > len(data): return False
        if struct.unpack_from('<I', data, base)[0] != MACHO64_LE: return False
        ncmds  = struct.unpack_from('<I', data, base + 16)[0]
        off    = base + 32
        hit    = False
        for _ in range(ncmds):
            if off + 8 > len(data): break
            cmd     = struct.unpack_from('<I', data, off)[0]
            cmdsize = struct.unpack_from('<I', data, off + 4)[0]
            if cmd == LC_BUILD_VERSION and off + 12 <= len(data):
                if struct.unpack_from('<I', data, off + 8)[0] == PLATFORM_IOS:
                    struct.pack_into('<I', data, off + 8, PLATFORM_IOSSIM)
                    hit = True
            if cmdsize == 0: break
            off += cmdsize
        return hit

    path = sys.argv[1]
    with open(path, 'rb') as f:
        data = bytearray(f.read())

    patched = False
    i = 0
    target = struct.pack('<I', MACHO64_LE)
    while True:
        idx = data.find(target, i)
        if idx == -1: break
        if patch_macho_at(data, idx):
            patched = True
        i = idx + 4

    if patched:
        with open(path, 'wb') as f: f.write(data)
        print(f"patched:{os.path.basename(path)}")
  PYTHON

  pods_root = installer.sandbox.root.to_s

  Dir.glob("#{pods_root}/**/*.framework").each do |fw_dir|
    fw_name = File.basename(fw_dir, '.framework')
    binary  = File.join(fw_dir, fw_name)
    next unless File.exist?(binary)

    file_info = `file "#{binary}" 2>/dev/null`

    # Check ar archive FIRST — fat binaries with ar slices also contain "Mach-O"
    # in their file description, so we must distinguish before vtool branch.
    if file_info.include?('ar archive') && file_info.include?('arm64')
      tmp     = "/tmp/fw_arm64_#{fw_name}.a"
      next unless system("lipo '#{binary}' -thin arm64 -output '#{tmp}' 2>/dev/null")

      out = `python3 '#{patcher_path}' '#{tmp}' 2>&1`
      if out.include?('patched:')
        x86_a = "/tmp/fw_x86_#{fw_name}.a"
        has_x86 = system("lipo '#{binary}' -thin x86_64 -output '#{x86_a}' 2>/dev/null")
        if has_x86 && File.exist?(x86_a) && File.size(x86_a) > 0
          system("lipo -create '#{x86_a}' '#{tmp}' -output '#{binary}'")
          File.delete(x86_a)
        else
          FileUtils.cp(tmp, binary)
        end
        puts "  ✓ #{fw_name} patched (in-place ar scan)"
      end
      File.delete(tmp) if File.exist?(tmp)

    elsif file_info.include?('Mach-O') && file_info.include?('arm64')
      # Pure Mach-O binary (not ar archive) — vtool patches it directly
      build_info = `vtool -show-build "#{binary}" 2>/dev/null`
      if build_info.include?('platform IOS') && !build_info.include?('platform IOSSIMULATOR')
        system("vtool -arch arm64 -set-build-version iossim 15.5 15.5 -replace -output '#{binary}' '#{binary}' 2>/dev/null")
        puts "  ✓ #{fw_name} patched (vtool)"
      end
    end
  end
end
