platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  require 'fileutils'

  # Patch device-only arm64 static frameworks to work with arm64 iOS Simulator.
  # MLKit and related pods ship only an iOS-device arm64 slice; we binary-patch
  # the LC_BUILD_VERSION platform field from PLATFORM_IOS(2) to
  # PLATFORM_IOSSIMULATOR(7) in each object file so Xcode's linker accepts them.
  patcher_path = '/tmp/patch_ios_to_sim.py'
  File.write(patcher_path, <<~'PYTHON')
    import struct, sys, os
    LC_BUILD_VERSION  = 0x32
    PLATFORM_IOS      = 2
    PLATFORM_IOSSIM   = 7
    path = sys.argv[1]
    with open(path, 'rb') as f:
        data = bytearray(f.read())
    if struct.unpack_from('<I', data, 0)[0] != 0xFEEDFACF:
        sys.exit(0)
    ncmds  = struct.unpack_from('<I', data, 16)[0]
    offset = 32
    patched = False
    for _ in range(ncmds):
        if offset + 8 > len(data): break
        cmd     = struct.unpack_from('<I', data, offset)[0]
        cmdsize = struct.unpack_from('<I', data, offset + 4)[0]
        if cmd == LC_BUILD_VERSION and offset + 12 <= len(data):
            if struct.unpack_from('<I', data, offset + 8)[0] == PLATFORM_IOS:
                struct.pack_into('<I', data, offset + 8, PLATFORM_IOSSIM)
                patched = True
        if cmdsize == 0: break
        offset += cmdsize
    if patched:
        with open(path, 'wb') as f: f.write(data)
        print(f"patched:{os.path.basename(path)}")
  PYTHON

  pods_root = installer.sandbox.root.to_s

  Dir.glob("#{pods_root}/**/*.framework").each do |fw_dir|
    fw_name = File.basename(fw_dir, '.framework')
    binary  = File.join(fw_dir, fw_name)
    next unless File.exist?(binary)

    file_info = `file "#{binary}" 2>/dev/null`
    next unless file_info.include?('ar archive') && file_info.include?('arm64')

    tmp = "/tmp/fw_patch_#{fw_name}"
    FileUtils.rm_rf(tmp)
    FileUtils.mkdir_p(tmp)

    begin
      arm64_a = File.join(tmp, 'arm64.a')
      next unless system("lipo '#{binary}' -thin arm64 -output '#{arm64_a}' 2>/dev/null")

      obj_dir = File.join(tmp, 'objs')
      FileUtils.mkdir_p(obj_dir)
      system("cd '#{obj_dir}' && ar x '#{arm64_a}' 2>/dev/null")

      objs = Dir.glob(File.join(obj_dir, '*.o'))
      next if objs.empty?

      patched_any = false
      objs.each do |obj|
        out = `python3 '#{patcher_path}' '#{obj}' 2>&1`
        patched_any = true if out.include?('patched:')
      end
      next unless patched_any

      sim_a    = File.join(tmp, 'sim_arm64.a')
      obj_list = objs.map { |o| "'#{o}'" }.join(' ')
      system("ar rcs '#{sim_a}' #{obj_list} 2>/dev/null")
      system("ranlib '#{sim_a}' 2>/dev/null")

      x86_a   = File.join(tmp, 'x86_64.a')
      has_x86 = system("lipo '#{binary}' -thin x86_64 -output '#{x86_a}' 2>/dev/null")

      if has_x86 && File.exist?(x86_a) && File.size(x86_a) > 0
        system("lipo -create '#{x86_a}' '#{sim_a}' -output '#{binary}'")
      else
        FileUtils.cp(sim_a, binary)
      end

      puts "  ✓ #{fw_name} patched for arm64 simulator"
    rescue => e
      puts "  ✗ #{fw_name} patch failed: #{e.message}"
    ensure
      FileUtils.rm_rf(tmp)
    end
  end
end
